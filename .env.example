# Образец env (скопировать и заполнить):
#   .env.development — разработка (yarn dev);
#   .env.production  — сборка для сервера (make env / PRODUCTION_ENV в CI).
# VITE_* встраиваются в статику при сборке.

# Dev-сервер (только .env.development).
VITE_HOST=localhost
VITE_PORT=3000

# Бэкенд: адрес API и Socket.IO. В dev — цель прокси /api.
# Для сервера — его адрес, например http://203.0.113.10:8182.
VITE_BASE_URL=http://localhost:8181
VITE_SOCKET_BASE_URL=http://localhost:8181

VITE_APP_NAME='WG Admin'
