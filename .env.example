# Образец env (скопировать и заполнить):
#   .env.development — разработка (yarn dev): cp .env.example .env.development;
#   .env.production  — сборка для сервера (make env / PRODUCTION_ENV в CI).
# Локальная сборка в Docker (make local-up) — .env.docker, образец .env.docker.example.
# VITE_* встраиваются в статику при сборке.

# Dev-сервер (только .env.development).
VITE_HOST=localhost
VITE_PORT=3001

# Бэкенд wg-admin-api: адрес API и Socket.IO. В dev — цели прокси /api и /socket.io
# (браузер ходит на сам dev-сервер). Для сервера — его адрес, например
# http://203.0.113.10:8182.
VITE_BASE_URL=http://localhost:8182
VITE_SOCKET_BASE_URL=http://localhost:8182

VITE_APP_NAME='WG Admin'
