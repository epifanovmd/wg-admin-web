# Зависимости — устанавливаются внутри образа
node_modules

# Артефакты сборки и тестов — генерируются внутри образа
dist
coverage
.tanstack
.eslintcache

# Git, CI и инструменты разработки
.git
.gitignore
.github
.claude
.vscode
.idea

# Документация — сборке не нужна
docs
*.md

# Env разработки и деплоя; сборке нужен только .env.[BUILD_MODE]: .env.production
# (сервер) или .env.docker (make local-up)
.env.development
.env.local
.env.*.local
.env.deploy*
.env.example
.env.docker.example

# Логи и временные файлы
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-артефакты
.DS_Store
Thumbs.db
